<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">
    <!-- Ground plane, inlined instead of the Fuel "Ground Plane" model so its
         visual can be SEE-THROUGH. Hand-taught / scanned marker poses can land
         a centimetre or two under z=0 (the arm's base_link origin is not exactly
         the bench surface), and a printer placed from such a marker puts its
         ArUco plate just below the floor. Against the opaque Fuel plane the
         camera then sees nothing and every scan of that marker fails. At alpha
         0.25 the tag still reads through the floor while the plane stays
         visible as a reference.
         VISUAL-ONLY on purpose: no collision element. Scanned marker poses a
         couple of cm below z=0 mean scrape waypoints can dip the gripper under
         the floor; a solid floor then wedges the arm and the trajectory
         controller aborts (CONTROL_FAILED). When floor physics IS wanted,
         runner_common.add_gz_floor_collision spawns a separate static
         collision box (collisions=True runs do this automatically). -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <transparency>0.75</transparency>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 0.25</ambient>
            <diffuse>0.8 0.8 0.8 0.25</diffuse>
            <specular>0.8 0.8 0.8 0.25</specular>
          </material>
        </visual>
      </link>
    </model>
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun
      </uri>
    </include>

    <!-- Declaring any plugin suppresses gz's default systems, so all four
         core systems must be listed. Sensors is the one actually being
         added (needed for the D435i camera topics). -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 0</gravity>
    </physics>

  </world>
</sdf>
